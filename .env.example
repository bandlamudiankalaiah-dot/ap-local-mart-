# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Secret key for token verification & session signing
JWT_SECRET="andhra_mart_secure_jwt_secret_token_2026"

# Supported Indian Payment Gateway API Configuration (Razorpay Test/Live Mode)
RAZORPAY_KEY_ID="rzp_test_AndhraMartAP2026"
RAZORPAY_KEY_SECRET="rzp_secret_andhra_mart_hmac_2026"
PAYMENT_GATEWAY_KEY="rzp_test_andhra_mart_gateway"
PAYMENT_GATEWAY_SECRET="rzp_secret_andhra_mart_key_secure"

# Optional API Base URL for standalone Frontend deployments (Vercel / Render)
VITE_API_BASE_URL=""

# Vercel Deployment Token (for CLI deployment)
VERCEL_TOKEN=""
KRISHNA_API_KEY=""
